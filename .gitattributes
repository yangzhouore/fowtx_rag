# Normalize all text files to LF in the repo, convert to OS-native on checkout
* text=auto eol=lf

# Explicitly declare text files
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.env text eol=lf

# Binary files — never convert
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.db binary
*.sqlite3 binary
